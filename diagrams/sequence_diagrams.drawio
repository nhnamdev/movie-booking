        </mxCell>

        <!-- Controller: catalogController -->
        <mxCell id="ll_ctrl" value=":catalogController&#xa;(Controller)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="440" y="50" width="150" height="700" as="geometry" />
        </mxCell>
        <mxCell id="act_ctrl" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="ll_ctrl">
          <mxGeometry x="70" y="80" width="10" height="570" as="geometry" />
        </mxCell>

        <!-- Model: Showtime -->
        <mxCell id="ll_showtime" value=":Showtime&#xa;(Domain Class)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
