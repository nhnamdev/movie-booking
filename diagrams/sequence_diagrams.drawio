          <mxGeometry x="60" y="150" width="10" height="200" as="geometry" />
        </mxCell>

        <!-- Model: Movie -->
        <mxCell id="ll_movie" value=":Movie&#xa;(Domain Class)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="830" y="50" width="130" height="700" as="geometry" />
