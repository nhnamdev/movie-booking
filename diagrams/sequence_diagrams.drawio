          <mxGeometry x="60" y="440" width="10" height="150" as="geometry" />
        </mxCell>

        <!-- Database: MySQL -->
        <mxCell id="ll_db" value=":Database (MySQL)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1010" y="50" width="140" height="700" as="geometry" />
        </mxCell>
        <mxCell id="act_db" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="ll_db">
          <mxGeometry x="65" y="170" width="10" height="430" as="geometry" />
        </mxCell>

        <!-- ==================== 2. MESSAGES ==================== -->
        <!-- 1. User chọn rạp & ngày -->
        <mxCell id="msg_1" value="1. Chọn rạp chiếu &amp; ngày trên giao diện" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=1.5;" edge="1" parent="1" source="act_user" target="act_view">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="200" y="130" /></Array></mxGeometry>
        </mxCell>

        <!-- 2. View -> Controller: POST /showtimes -->
        <mxCell id="msg_2" value="2. POST /showtimes { theatreName, userGenre }" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=1.5;" edge="1" parent="1" source="act_view" target="act_ctrl">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="160" /></Array></mxGeometry>
        </mxCell>

        <!-- 3. Controller -> Showtime: getShowtimes() -->
        <mxCell id="msg_3" value="3. getShowtimes(theatreName, userGenre)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=1.5;" edge="1" parent="1" source="act_ctrl" target="act_showtime">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="600" y="190" /></Array></mxGeometry>
        </mxCell>

        <!-- 4. Showtime -> DB: Query showtimes -->
        <mxCell id="msg_4" value="4. SELECT M.*, S.*, H.name FROM theatre JOIN hall JOIN showtimes JOIN movie..." style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=1.5;" edge="1" parent="1" source="act_showtime" target="act_db">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="220" /></Array></mxGeometry>
        </mxCell>

        <!-- 5. DB -> Showtime: Kết quả SQL -->
        <mxCell id="msg_5" value="5. Trả về bảng ghi các suất chiếu, phòng chiếu &amp; giá vé" style="html=1;verticalAlign=bottom;endArrow=dashed;rounded=0;strokeWidth=1.5;" edge="1" parent="1" source="act_db" target="act_showtime">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="250" /></Array></mxGeometry>
        </mxCell>

        <!-- 6. Showtime -> Controller -->
        <mxCell id="msg_6" value="6. Danh sách đối tượng Showtime[]" style="html=1;verticalAlign=bottom;endArrow=dashed;rounded=0;strokeWidth=1.5;" edge="1" parent="1" source="act_showtime" target="act_ctrl">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="600" y="280" /></Array></mxGeometry>
        </mxCell>

