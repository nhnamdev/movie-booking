        </mxCell>

        <mxCell id="s8_expired_cancel" value="Hủy giữ ghế, hoàn điểm giữ &amp; báo giao dịch hết hạn" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;" vertex="1" parent="lane_sys">
          <mxGeometry x="200" y="700" width="150" height="55" as="geometry" />
        </mxCell>

        <mxCell id="s8_db_transaction" value="Chạy MySQL Transaction: PAID đơn hàng, tạo vé (Ticket), ghi sổ điểm &amp; gửi email" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;" vertex="1" parent="lane_sys">
