        <mxCell id="lbl_paid_no" value="Sai" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="lane_sys">
          <mxGeometry x="250" y="620" width="35" height="20" as="geometry" />
