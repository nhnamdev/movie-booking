<mxfile host="app.diagrams.net" agent="Codex">
  <diagram id="ad-uc008-standalone" name="AD_UC008_ThanhToanPayOS">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ==================== SWIMLANES ==================== -->
        <!-- Lane 1: Khách hàng -->
        <mxCell id="lane_user" value="Khách hàng" style="swimlane;" vertex="1" parent="1">
          <mxGeometry x="100" y="50" width="280" height="920" as="geometry" />
        </mxCell>

        <!-- Start State -->
        <mxCell id="node_start" value="" style="ellipse;html=1;shape=startState;fillColor=#000000;strokeColor=#ff0000;" vertex="1" parent="lane_user">
          <mxGeometry x="125" y="30" width="30" height="30" as="geometry" />
        </mxCell>

        <mxCell id="u8_review_order" value="Kiểm tra thông tin đơn hàng &amp; chọn PayOS (VietQR)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;" vertex="1" parent="lane_user">
          <mxGeometry x="65" y="90" width="150" height="50" as="geometry" />
        </mxCell>

        <mxCell id="u8_click_pay" value="Nhấn nút &quot;Thanh toán ngay&quot;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;" vertex="1" parent="lane_user">
          <mxGeometry x="70" y="195" width="140" height="45" as="geometry" />
        </mxCell>

        <mxCell id="u8_scan_qr" value="Quét mã VietQR trên App ngân hàng &amp; chuyển khoản" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;" vertex="1" parent="lane_user">
          <mxGeometry x="65" y="420" width="150" height="50" as="geometry" />
        </mxCell>

        <mxCell id="u8_view_tickets" value="Nhận thông báo thành công &amp; vé điện tử kèm mã QR check-in" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;" vertex="1" parent="lane_user">
          <mxGeometry x="60" y="750" width="160" height="55" as="geometry" />
        </mxCell>

        <!-- End State -->
        <mxCell id="node_end" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#ff0000;" vertex="1" parent="lane_user">
          <mxGeometry x="125" y="855" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- Lane 1 Internal Connections -->
        <mxCell id="edge_start" edge="1" parent="lane_user" source="node_start" target="u8_review_order" style="endArrow=classic;html=1;rounded=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="edge_review_click" edge="1" parent="lane_user" source="u8_review_order" target="u8_click_pay" style="endArrow=classic;html=1;rounded=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="edge_tickets_end" edge="1" parent="lane_user" source="u8_view_tickets" target="node_end" style="endArrow=classic;html=1;rounded=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Lane 2: Hệ thống & Cổng PayOS -->
        <mxCell id="lane_sys" value="Hệ thống (Web, Server &amp; PayOS)" style="swimlane;startSize=23;" vertex="1" parent="1">
          <mxGeometry x="380" y="50" width="370" height="920" as="geometry" />
        </mxCell>

        <mxCell id="s8_hold_seats" value="Tạo giữ ghế (seat_hold) &amp; giữ điểm thưởng trong 10 phút" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;" vertex="1" parent="lane_sys">
