        <mxCell id="edge_paid_no" edge="1" parent="lane_sys" source="s8_check_paid" target="s8_expired_cancel" style="endArrow=classic;html=1;rounded=1;curved=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
