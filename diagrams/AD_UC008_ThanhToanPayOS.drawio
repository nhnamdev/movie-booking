        </mxCell>

        <mxCell id="s8_create_paylink" value="Gọi API PayOS: Khởi tạo liên kết thanh toán (orderCode, số tiền, QR)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;" vertex="1" parent="lane_sys">
          <mxGeometry x="105" y="300" width="160" height="55" as="geometry" />
        </mxCell>

        <mxCell id="s8_show_qr_timer" value="Hiển thị mã VietQR &amp; đồng hồ đếm ngược 10:00" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;" vertex="1" parent="lane_sys">
          <mxGeometry x="105" y="418" width="160" height="55" as="geometry" />
        </mxCell>

        <mxCell id="s8_receive_webhook" value="Nhận Webhook PayOS xác nhận chuyển khoản" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;" vertex="1" parent="lane_sys">
          <mxGeometry x="105" y="520" width="160" height="45" as="geometry" />
